    {
      "type": "standard",
      "title": "Welcome",
      "dialog_node": "node_e423626d0972",
      "output": {
        "generic": [
          {
            "response_type": "text",
            "values": [
              {
                "text": "Hello! Welcome to the CU Boulder Campus Help Desk. I can help you with:\n\n- Course registration\n- Tutoring sessions\n- Professor office hours\n- Parking information\n- Dining hall hours & options\n\nWhat do you need help with?"
              }
            ],
            "selection_policy": "sequential"
          }
        ]
      },
      "conditions": "welcome"
    },
    {
      "type": "standard",
      "title": "Greeting",
      "dialog_node": "node_7e75c4d5c2df",
      "output": {
        "generic": [
          {
            "response_type": "text",
            "values": [
              {
                "text": "Hi there! How can I help you today? I can assist with registration, tutoring, office hours, parking, and dining."
              },
              {
                "text": "Hey! Welcome to the CU Boulder Help Desk. What can I do for you?"
              },
              {
                "text": "Hello! Ready to help. What do you need assistance with today?"
              }
            ],
            "selection_policy": "random"
          }
        ]
      },
      "conditions": "#greeting",
      "previous_sibling": "node_e423626d0972"
    },
    {
      "type": "standard",
      "title": "Help",
      "dialog_node": "node_ea0fbc4e7305",
      "output": {
        "generic": [
          {
            "response_type": "text",
            "values": [
              {
                "text": "Here's what I can help with:\n\n- Registration: Schedule a registration appointment\n- Tutoring: Book a tutoring session\n- Office Hours: Find professor/TA office hours\n- Parking: Lot locations, permits, directions\n- Dining: Dining hall hours and meal plans\n\nYou can also ask about campus hours, or say 'talk to a person' if you need human help. Just tell me what you need!"
              }
            ],
            "selection_policy": "sequential"
          }
        ]
      },
      "conditions": "#help",
      "previous_sibling": "node_7e75c4d5c2df"
    },
