  "dialog_nodes": [
    {
      "type": "standard",
      "title": "Welcome",
      "dialog_node": "node_698fcf8d3eac",
      "output": {
        "generic": [
          {
            "response_type": "text",
            "values": [
              {
                "text": "Hello! Welcome to the CU Boulder Campus Help Desk. I can help you with:\n\n- Course registration\n- Tutoring sessions\n- Professor office hours\n- Parking information\n- Dining hall hours & options\n\nWhat do you need help with?"
              }
            ],
            "selection_policy": "sequential"
          }
        ]
      },
      "conditions": "welcome"
    },
    {
      "type": "standard",
      "title": "Greeting",
      "dialog_node": "node_d2451abe7608",
      "output": {
        "generic": [
          {
            "response_type": "text",
            "values": [
              {
                "text": "Hi there! How can I help you today? I can assist with registration, tutoring, office hours, parking, and dining."
              },
              {
                "text": "Hey! Welcome to the CU Boulder Help Desk. What can I do for you?"
              },
              {
                "text": "Hello! Ready to help. What do you need assistance with today?"
              }
            ],
            "selection_policy": "random"
          }
        ]
      },
      "conditions": "#greeting",
      "previous_sibling": "node_698fcf8d3eac"
    },
    {
      "type": "standard",
      "title": "Help",
      "dialog_node": "node_1ce07f075c90",
      "output": {
        "generic": [
          {
            "response_type": "text",
            "values": [
              {
                "text": "Here's what I can help with:\n\n- Registration: Schedule a registration appointment\n- Tutoring: Book a tutoring session\n- Office Hours: Find professor/TA office hours\n- Parking: Lot locations, permits, directions\n- Dining: Dining hall hours and meal plans\n\nYou can also ask about campus hours, or say 'talk to a person' if you need human help."
              }
            ],
            "selection_policy": "sequential"
          }
        ]
      },
      "conditions": "#help",
      "previous_sibling": "node_d2451abe7608"
    },
    {
      "type": "standard",
      "title": "Collect Name",
      "dialog_node": "node_4bdacbdb0c27",
      "output": {
        "generic": [
          {
            "response_type": "text",
            "values": [
              {
                "text": "Nice to meet you! What can I help you with today?"
              }
            ],
            "selection_policy": "sequential"
          }
        ]
      },
      "context": {
        "user_name": "<? input.text.replace('my name is ', '').replace('My name is ', '').replace('I am ', '').replace('i am ', '').replace(\"I'm \", '').replace(\"i'm \", '').trim() ?>"
      },
      "conditions": "input.text.contains('my name is') || input.text.contains('My name is') || input.text.contains('I am ') || input.text.contains(\"I'm \")",
      "previous_sibling": "node_1ce07f075c90"
    },
